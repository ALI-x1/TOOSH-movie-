<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Video surface: sized by OnNewVideoLayoutListener so the
         picture is centred with the correct aspect ratio, instead
         of sitting low with a big black area below it. -->
    <SurfaceView
        android:id="@+id/player_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- libVLC subtitles surface: transparent, overlays the video.
         Its bottom margin is raised while the controls are visible,
         so subtitles sit above the controls, never behind the
         play button. -->
    <SurfaceView
        android:id="@+id/player_subtitle_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Subtitles (ExoPlayer fallback only; libVLC renders its own
         subtitles on the subtitles surface above). -->
    <TextView
        android:id="@+id/player_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="170dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:gravity="center"
        android:maxLines="3"
        android:visibility="gone" />

    <!-- Gesture feedback: vector icon + value, no box at all.
         Just a white icon and white text with a shadow, floating
         over the video, exactly as requested. -->
    <LinearLayout
        android:id="@+id/player_gesture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/player_gesture_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/player_gesture_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#F6EFDC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:gravity="center" />
    </LinearLayout>

    <!-- Top bar: VLC-style, gradient, back arrow + title -->
    <LinearLayout
        android:id="@+id/player_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="@drawable/player_bar_top"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F6EFDC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/player_tracks"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_tracks"
            android:scaleType="center"
            android:background="@drawable/player_btn_circle"
            android:contentDescription="Audio and subtitles" />

        <ImageButton
            android:id="@+id/player_lock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_lock"
            android:scaleType="center"
            android:background="@drawable/player_btn_circle"
            android:contentDescription="Lock" />

        <TextView
            android:id="@+id/player_close"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="خروج"
        android:drawableEnd="@drawable/ic_close"
        android:drawablePadding="6dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/player_btn_play" />
    </LinearLayout>

    <!-- Bottom bar: VLC-style, softer gradient so subtitles
         behind it stay readable, play button on the left (like
         VLC), not in the centre under the subtitles. -->
    <LinearLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/player_bar_bottom">

        <SeekBar
            android:id="@+id/player_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressDrawable="@drawable/player_seek_progress"
            android:thumb="@drawable/player_seek_thumb"
            android:splitTrack="false"
            android:minHeight="14dp"
            android:maxHeight="14dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/player_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_pause"
                android:scaleType="center"
                android:background="@drawable/player_btn_play"
                android:contentDescription="Play pause" />

            <FrameLayout
                android:id="@+id/player_back10"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/player_btn_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_rewind" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10"
                    android:textColor="#F6EFDC"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/player_forward10"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/player_btn_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_fast_forward" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10"
                    android:textColor="#F6EFDC"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:background="@drawable/player_time_pill">

                <TextView
                    android:id="@+id/player_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#FF6B8A"
                    android:textSize="12sp"
                    android:text="00:00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#F6EFDC"
                    android:textSize="12sp"
                    android:text=" / " />

                <TextView
                    android:id="@+id/player_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#F6EFDC"
                    android:textSize="12sp"
                    android:text="00:00" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/player_speed"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="1x"
                android:textAllCaps="false"
                android:textColor="#F6EFDC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/player_btn_circle" />

            <ImageButton
                android:id="@+id/player_aspect"
                android:layout_marginLeft="8dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_fullscreen"
                android:scaleType="center"
                android:background="@drawable/player_btn_circle"
                android:contentDescription="Aspect" />

            <Button
                android:id="@+id/player_cc"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:text="CC"
                android:textColor="#F6EFDC"
                android:textSize="13sp"
                android:background="@drawable/player_btn_cc_on" />
        </LinearLayout>
    </LinearLayout>

    <!-- Loading animation: rotating yellow/cream/orange rings
         around a pulsing play mark, plus text below. No box
         around it, just the animation floating over the video.
         Shown while the film is loading/buffering, hidden as
         soon as playback actually starts. -->
    <LinearLayout
        android:id="@+id/player_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="در حال بارگذاری فیلم"
            android:textColor="#F6EFDC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:gravity="center" />
    </LinearLayout>

    <!-- Error box -->
    <LinearLayout
        android:id="@+id/player_error_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/player_card"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F6EFDC"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/player_retry"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:text="تلاش مجدد"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/player_btn_retry" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/player_unlock"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|left"
        android:layout_marginLeft="20dp"
        android:src="@drawable/ic_lock"
        android:scaleType="center"
        android:background="@drawable/player_btn_play"
        android:visibility="gone"
        android:contentDescription="Unlock" />

    <LinearLayout
        android:id="@+id/player_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="110dp"
        android:layout_marginRight="16dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:minWidth="240dp"
        android:background="@drawable/player_card"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="قسمت بعدی"
            android:textColor="#FFD60A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="260dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#F6EFDC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_next_now"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:clickable="true"
                android:focusable="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/player_btn_play" />

            <TextView
                android:id="@+id/player_next_cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:clickable="true"
                android:focusable="true"
                android:text="لغو"
                android:textColor="#F6EFDC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/player_btn_circle" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
