<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- hard offset shadow, same as the site's neo-brutal buttons -->
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F6EFDC" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#EE3B17" />
            <stroke android:width="2dp" android:color="#F6EFDC" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
